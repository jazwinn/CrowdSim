{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Visual Studio 2026)",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows MSVC + Ninja Multi-Config (run from a VS dev shell)",
      "inherits": "windows-base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja Multi-Config)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos",
      "displayName": "macOS Apple Silicon (Ninja Multi-Config)",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless only (no GUI deps), host default generator",
      "inherits": "base",
      "cacheVariables": { "CROWDSIM_BUILD_GUI": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc", "configuration": "Debug" },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja", "configuration": "Release" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" },
    { "name": "macos-release", "configurePreset": "macos", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-release", "configurePreset": "macos", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
